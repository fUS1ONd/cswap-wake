#!/usr/bin/env python3
"""Open the 5-hour Claude Code usage windows on every cswap account.

Cron runs the script every minute; most ticks only read the state file.
Each account has its own next ping time (next). When it comes:
  - the 5h window is already open (manual use, auto-switch): no ping,
    next = window reset + 1 min;
  - the weekly limit is used up: no ping, next = weekly reset + 1 min;
  - otherwise a short prompt via cswap run (the active account is untouched),
    next = now + 5 h 1 min.
Accounts are spaced 30 minutes apart: a new one takes the nearest free slot,
and if several are due at once, the extra ones shift by 30 minutes.
Accounts are keyed by email + org, so cswap swap/move don't confuse them.

  cswap-wake          one tick (for cron)
  cswap-wake status   show the schedule
"""
import datetime as dt
import fcntl
import json
import os
import subprocess
import sys

# Where the schedule is kept between runs (per-account next ping, last result)
STATE_DIR = os.path.expanduser("~/.local/state/cswap-wake")
STATE_FILE = os.path.join(STATE_DIR, "state.json")
# Held during a tick so two cron runs never ping at the same time
LOCK_FILE = os.path.join(STATE_DIR, "lock")

# Time from a successful ping to the next one: the window lasts 5 h, plus a minute
# so we never hit an account just before its window resets
CYCLE = dt.timedelta(hours=5, minutes=1)
# Spacing between accounts, so their limits don't all reset at once
STEP = dt.timedelta(minutes=30)
# Margin after a window or weekly reset before pinging an account again
GRACE = dt.timedelta(minutes=1)
# Delay before retrying an account whose ping failed
RETRY = dt.timedelta(minutes=15)
# How often to re-read cswap for added, removed or disabled accounts
DISCOVERY = dt.timedelta(minutes=30)

# Empty context: with no tools, MCP, skills or CLAUDE.md the request costs
# ~540 tokens instead of ~24k and opens the window all the same
CLAUDE_ARGS = ["-p", os.environ.get("CLAUDE_WAKE_PROMPT", "qq"),
               "--model", os.environ.get("CLAUDE_WAKE_MODEL", "claude-haiku-5-5"),
               "--effort", "low", "--tools", "", "--system-prompt", "Reply with one word.",
               "--strict-mcp-config", "--disable-slash-commands", "--setting-sources", ""]


def utcnow():
    return dt.datetime.now(dt.timezone.utc).replace(microsecond=0)


def parse(ts):
    if not ts:
        return None
    return dt.datetime.fromisoformat(ts.replace("Z", "+00:00")).replace(microsecond=0)


def log(msg):
    print(f"[cswap-wake {utcnow():%Y-%m-%d %H:%M} UTC] {msg}", flush=True)


def load_state():
    try:
        with open(STATE_FILE) as f:
            return json.load(f)
    except FileNotFoundError:
        return {"accounts": {}, "next_discovery": None}


def save_state(state):
    tmp = STATE_FILE + ".tmp"
    with open(tmp, "w") as f:
        json.dump(state, f, indent=1, ensure_ascii=False)
    os.replace(tmp, STATE_FILE)


def fetch_accounts():
    out = subprocess.run(["cswap", "list", "--json"], capture_output=True,
                         text=True, check=True).stdout
    return {f'{a["email"]}|{a["organizationUuid"]}': a
            for a in json.loads(out)["accounts"] if not a.get("disabled")}


def free_slot(now, taken):
    """Earliest time >= now that is at least STEP away from every other next."""
    t = now
    while any(abs(t - o) < STEP for o in taken):
        t += STEP
    return t


def window_reset(acc, now):
    """Until when a ping is pointless: an open 5h window or an exhausted week."""
    usage = acc.get("usage") or {}
    week = usage.get("sevenDay") or {}
    week_reset = parse(week.get("resetsAt"))
    if week.get("pct", 0) >= 100 and week_reset and week_reset > now:
        return week_reset, "недельный лимит"
    five_reset = parse((usage.get("fiveHour") or {}).get("resetsAt"))
    if five_reset and five_reset > now:
        return five_reset, "окно уже открыто"
    return None, None


def ping(num):
    r = subprocess.run(["cswap", "run", str(num), "--", *CLAUDE_ARGS],
                       capture_output=True, text=True, timeout=300)
    reply = (r.stdout.strip().splitlines() or [""])[-1]
    return r.returncode == 0, reply or r.stderr.strip()[-300:]


def tick():
    now = utcnow()
    state = load_state()
    sched = state["accounts"]
    due = [k for k, s in sched.items() if parse(s["next"]) <= now]
    disc = parse(state.get("next_discovery"))
    if not due and disc and disc > now:
        return

    accounts = fetch_accounts()
    for key in list(sched):
        if key not in accounts:
            log(f"{sched.pop(key)['email']} пропал из cswap — забыт")
    for key, acc in accounts.items():
        if key not in sched:
            taken = [parse(s["next"]) for s in sched.values()]
            sched[key] = {"email": acc["email"],
                          "next": free_slot(now, taken).isoformat()}
            log(f"новый аккаунт {acc['email']}, первый пинг {sched[key]['next']}")
    state["next_discovery"] = (now + DISCOVERY).isoformat()

    due = sorted((k for k, s in sched.items() if parse(s["next"]) <= now),
                 key=lambda k: accounts[k]["number"])
    pinged = False
    for key in due:
        acc, s = accounts[key], sched[key]
        s["number"] = acc["number"]
        reset, why = window_reset(acc, now)
        if reset:
            s["next"] = (reset + GRACE).isoformat()
            log(f"Account-{acc['number']} {acc['email']}: {why}, следующий раз {s['next']}")
        elif pinged:
            # Never ping two at once: keep the 30-minute spacing
            taken = [parse(o["next"]) for k, o in sched.items() if k != key]
            s["next"] = free_slot(now + STEP, taken).isoformat()
        else:
            pinged = True
            ok, reply = ping(acc["number"])
            s["last_ping"] = now.isoformat()
            s["last_ok"] = ok
            s["next"] = (now + (CYCLE if ok else RETRY)).isoformat()
            log(f"Account-{acc['number']} {acc['email']}: "
                f"{'ok' if ok else 'ОШИБКА'} «{reply}», следующий раз {s['next']}")
        save_state(state)
    save_state(state)


def status():
    state = load_state()
    rows = sorted(state["accounts"].values(), key=lambda s: s["next"])
    for s in rows:
        nxt = parse(s["next"]).astimezone(dt.timezone(dt.timedelta(hours=3)))
        last = "ok" if s.get("last_ok") else ("ошибка" if "last_ok" in s else "—")
        print(f"{nxt:%d.%m %H:%M} MSK  #{s.get('number', '?'):<3} {s['email']:<40} "
              f"последний пинг: {s.get('last_ping', '—')} ({last})")


def main():
    os.makedirs(STATE_DIR, exist_ok=True)
    if sys.argv[1:] == ["status"]:
        return status()
    with open(LOCK_FILE, "w") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return  # the previous tick is still pinging
        tick()


if __name__ == "__main__":
    main()
